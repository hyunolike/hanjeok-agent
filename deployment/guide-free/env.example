# Copy outside the repository and pass with docker --env-file.
GUIDE_ENV=production
GUIDE_EMBEDDING_PROVIDER=nvidia
BENCH_ANSWER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
GUIDE_CORS_ALLOWED_ORIGINS=https://agent.hanjeok.com
GUIDE_LIVE_MODE=live
HANJEOK_BASE_URL=https://api.hanjeok.com
BENCH_NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
BENCH_NEO4J_USER=neo4j
BENCH_NEO4J_PASSWORD=
NVIDIA_API_KEY=
GUIDE_CHECKPOINT_DB=/tmp/guide/checkpoints.sqlite
GUIDE_RESET_CHECKPOINTS=1
GUIDE_TRUST_PROXY=0
GUIDE_MAX_CONCURRENT=1
GUIDE_MAX_VISITS=128
